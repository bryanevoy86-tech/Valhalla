# Production Environment Configuration
# Copy this to .env in Render and fill in actual values

# === DEPLOYMENT MODE ===
APP_ENV=production
DEBUG=false

# === CORE AUTHENTICATION ===
VALHALLA_JWT_SECRET=your_secret_key_here_min_32_chars
VALHALLA_OWNER_USERNAME=owner_username
VALHALLA_OWNER_PASSWORD_HASH=hashed_password_bcrypt

# === PUBLIC URL ===
PUBLIC_BASE_URL=https://yourdomain.com

# === STRIPE INTEGRATION ===
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_CONNECT_CLIENT_ID=ca_xxxxx

# === DOCUSIGN INTEGRATION ===
DOCUSIGN_CLIENT_ID=your_client_id
DOCUSIGN_CLIENT_SECRET=your_client_secret
DOCUSIGN_ACCOUNT_ID=your_account_id
DOCUSIGN_WEBHOOK_SECRET=your_webhook_secret
DOCUSIGN_API_BASE_URL=https://demo.docusign.net/restapi

# === AWS S3 STORAGE ===
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=valhalla-contracts-prod
AWS_REGION=us-east-1
AWS_S3_PREFIX=contracts/

# === QUICKBOOKS INTEGRATION ===
QB_CLIENT_ID=your_client_id
QB_CLIENT_SECRET=your_client_secret
QB_REALM_ID=your_realm_id
QB_ACCESS_TOKEN=your_oauth_token
QB_REFRESH_TOKEN=your_refresh_token

# === EMAIL/SMTP ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true
ALERT_EMAIL_TO=ops@yourdomain.com

# === PLAID INTEGRATION ===
PLAID_CLIENT_ID=your_client_id
PLAID_SECRET=your_secret
PLAID_ENVIRONMENT=production

# === OPERATIONS CONFIG ===
ARB_FEE_RATE=0.03
ALLOW_DESTRUCTIVE=false
AUTO_DEPLOY=true
ENABLE_CRON_JOBS=true
MONTHLY_REVENUE_TARGET=5000000

# === DATABASE ===
DATABASE_URL=postgresql://user:password@host:5432/valhalla

# === SECURITY ===
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOW_CREDENTIALS=true
SECURE_COOKIES=true
HTTPS_ONLY=true

# === MONITORING & LOGGING ===
LOG_LEVEL=INFO
SENTRY_DSN=your_sentry_url_if_using_sentry
